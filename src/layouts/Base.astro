---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
interface Props {
  title: string;
  description?: string;
  /** OG/Twitter 画像（サイトルートからの絶対パス）。既定はSNS共有用OG画像。 */
  image?: string;
  /** 構造化データ（JSON-LD）。オブジェクトを渡すと <script type="application/ld+json"> を出力する。 */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title,
  description = '災害で被災した企業が、まず確認すべき公的支援（給与・資金繰り・施設復旧・税）をすぐに調べられる情報サイト。',
  image = '/og.png',
  jsonLd,
} = Astro.props;

// canonical / og:url / og:image は絶対URL化する（Astro.site = 本番URL）。
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ReadyBridge" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='8' fill='%230f6e63'/><path d='M8 24 L8 17 Q16 9.5 24 17 L24 24' fill='none' stroke='white' stroke-width='3.2' stroke-linecap='round' stroke-linejoin='round'/><circle cx='8' cy='10.5' r='2.8' fill='white'/><circle cx='24' cy='10.5' r='2.8' fill='white'/></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;600;700&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="container inner">
        <a class="brand" href="/"><Logo variant="header" /></a>
        <nav class="nav" aria-label="メイン">
          <div class="nav-links" id="nav-links">
            <a href="/prepare">平時の備え</a>
            <a href="/recover">有事の対応</a>
            <a href="/faq">記事一覧</a>
            <a class="nav-about" href="/about">このサイトについて</a>
          </div>
          <a class="cta" href="/chat">AIに相談</a>
          <button class="menu-btn" type="button" aria-label="メニューを開く" aria-expanded="false" aria-controls="nav-links">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
              <line x1="4" y1="7" x2="20" y2="7" /><line x1="4" y1="12" x2="20" y2="12" /><line x1="4" y1="17" x2="20" y2="17" />
            </svg>
          </button>
        </nav>
      </div>
    </header>
    <script>
      // モバイルのハンバーガーメニュー開閉。
      const header = document.querySelector('.site-header');
      const menuBtn = document.querySelector('.menu-btn');
      menuBtn?.addEventListener('click', () => {
        const open = header!.classList.toggle('menu-open');
        menuBtn.setAttribute('aria-expanded', String(open));
        menuBtn.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
      });
      // メニュー内リンクへの遷移や外側タップで閉じる。
      document.addEventListener('click', (e) => {
        if (header?.classList.contains('menu-open') && !(e.target as HTMLElement).closest('.nav, .menu-btn')) {
          header.classList.remove('menu-open');
          menuBtn?.setAttribute('aria-expanded', 'false');
        }
      });
    </script>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <div class="cols">
          <div>
            <a class="brand" href="/"><Logo variant="footer" /></a>
            <p class="note">ReadyBridge は、企業と支援制度、企業と社会、そして平時と有事をつなぎます。被災した企業が、まず確認すべき公的支援をすぐに調べられる情報サイトです。</p>
          </div>
          <nav class="fnav">
            <a href="/">トップ</a>
            <a href="/prepare">平時の備え</a>
            <a href="/recover">有事の対応・再建</a>
            <a href="/faq">記事一覧</a>
            <a href="/chat">AIに相談</a>
            <a href="/about">このサイトについて</a>
          </nav>
        </div>
        <p class="copy">掲載情報は一般的な制度の概要です。実際の適用可否・要件は必ず各窓口・公式情報でご確認ください。｜ ReadyBridge（プロトタイプ）</p>
      </div>
    </footer>
  </body>
</html>
