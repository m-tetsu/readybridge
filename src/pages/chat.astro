---
import Base from '../layouts/Base.astro';
---
<Base title="AIに相談｜ReadyBridge" description="自社の状況に合わせて、災害時に使える公的支援をAIが出典付きで案内します（試験運用）。給与・資金繰り・施設復旧・税の疑問を相談できます。">
  <section class="hero">
    <div class="container">
      <span class="eyebrow reveal"><span class="dot"></span>AI相談（試験運用）</span>
      <h1 class="reveal d1 hero-head-line" style="font-size:clamp(1.8rem,4vw,2.8rem)"><span class="accent">自社の状況</span>に合わせて、AIが出典付きで回答</h1>
      <p class="lead lead-nowrap reveal d2">質問を入力すると、収集した公的な支援情報をもとに、出典リンク付きで回答します。</p>
    </div>
  </section>

  <section style="padding-top:6px">
    <div class="container" style="max-width:820px">
      <!-- 例質問（タップで入力欄へ） -->
      <div class="example-chips" role="group" aria-label="質問の例">
        <span class="ex-label">質問の例：</span>
        <button type="button" class="ex-chip">浸水で工場が使えません。まず何をすべきですか？</button>
        <button type="button" class="ex-chip">休業中の従業員の給与はどうすればいいですか？</button>
        <button type="button" class="ex-chip">BCPを作りたい。何から始めればいいですか？</button>
      </div>

      <!-- 質問入力フォーム -->
      <form class="chat-form" id="chat-form" autocomplete="off">
        <div class="ask-row">
          <textarea id="f-question" name="question" rows="2" required
            placeholder="質問を入力（例：浸水で休業中です。使える支援と、まず何をすべきか教えてください）"></textarea>
          <button class="btn ask-go" type="submit">相談する<span class="arr">→</span></button>
        </div>
        <p class="form-note">送信内容は回答の生成と、サイト改善のための統計分析に使います。個人を特定する情報は入力しないでください。</p>
      </form>

      <!-- 回答表示エリア -->
      <div class="chat-log" id="chat-log" aria-live="polite"></div>
    </div>
  </section>

  <!-- 免責①：常設スティッキー注記 -->
  <div class="disclaimer-bar" role="note">
    <div class="container">
      本回答はAIによる<b>参考情報</b>です。支援制度は災害・時期により変わります。申請前に必ず<b>出典の公式ページと窓口</b>でご確認ください。
    </div>
  </div>
</Base>

<style>
  .example-chips { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 0 2px 14px; }
  .ex-label { font-size: .82rem; font-weight: 700; color: var(--ink-soft); }
  .ex-chip {
    font: inherit; font-size: .85rem; color: var(--teal-dark); cursor: pointer;
    background: var(--teal-soft); border: 1px solid transparent; border-radius: 999px; padding: 7px 14px;
    transition: border-color .15s, background .15s;
  }
  .ex-chip:hover { border-color: var(--teal); background: var(--surface); }

  .chat-form { background: var(--surface, #fff); border: 1px solid var(--line, #e6e1d6); border-radius: 14px; padding: 18px; box-shadow: var(--shadow, 0 6px 20px rgba(0,0,0,.05)); }
  .ask-row { display: flex; gap: 10px; align-items: stretch; }
  .ask-row textarea {
    flex: 1; resize: vertical; width: 100%; box-sizing: border-box; padding: 10px 12px;
    border: 1.5px solid var(--line-strong, #d8d2c4); border-radius: 10px;
    font: inherit; color: inherit; background: #fff;
  }
  .ask-row textarea:focus {
    outline: none; border-color: var(--teal); box-shadow: 0 0 0 3px var(--teal-soft);
  }
  .ask-go { white-space: nowrap; align-self: stretch; }
  .form-note { font-size: .78rem; color: var(--ink-soft, #5b574e); margin: 10px 2px 0; }

  .chat-log { margin: 22px 0 40px; display: flex; flex-direction: column; gap: 16px; }
  .msg { border-radius: 12px; padding: 14px 16px; }
  .msg-user { background: var(--teal-soft); align-self: flex-end; max-width: 90%; }
  .msg-ai { background: var(--paper-2, #f5f5f5); border: 1px solid var(--line, #e6e1d6); }
  .msg-meta { font-size: .78rem; color: var(--ink-soft, #5b574e); margin: 0 0 6px; }
  .msg-body { line-height: 1.7; }
  /* AI回答の Markdown 整形（見出し・太字・箇条書き） */
  .msg-body .md > :first-child { margin-top: 0; }
  .msg-body .md > :last-child { margin-bottom: 0; }
  .msg-body .md p { margin: 0 0 .7em; }
  .msg-body .md h3 { font-size: 1.08rem; font-weight: 700; margin: 1.1em 0 .45em; color: var(--teal-dark); }
  .msg-body .md h4 { font-size: 1rem; font-weight: 700; margin: 1em 0 .4em; }
  .msg-body .md ul, .msg-body .md ol { margin: 0 0 .8em; padding-left: 1.4em; }
  .msg-body .md li { margin: .2em 0; }
  .msg-body .md li > ul { margin: .2em 0 0; }
  .msg-body .md strong { font-weight: 700; }
  .msg-body .md code { font-size: .9em; background: #fff; border: 1px solid var(--line, #e6e1d6); border-radius: 4px; padding: 0 4px; }
  .msg-body .md hr { border: 0; border-top: 1px dashed var(--line-strong, #d8d2c4); margin: 1em 0; }
  .msg-body .md a { color: var(--teal-dark); }
  .msg-pending .msg-body { color: var(--ink-soft, #5b574e); }
  .msg-pending .msg-body::after { content: '…'; display: inline-block; animation: dots 1.2s steps(4, end) infinite; }
  @keyframes dots { 0% { clip-path: inset(0 100% 0 0); } 100% { clip-path: inset(0 0 0 0); } }
  .btn[disabled] { opacity: .55; pointer-events: none; }

  /* 免責③：災害特設の但し書き */
  .disaster-note { margin-top: 10px; font-size: .82rem; color: var(--terra-dark); background: var(--terra-soft); border-radius: 8px; padding: 8px 10px; }

  /* 出典カード（論点④②：回答の根拠） */
  .sources { margin-top: 12px; border-top: 1px dashed var(--line-strong, #d8d2c4); padding-top: 10px; }
  .sources-title { font-size: .8rem; font-weight: 700; color: var(--ink-soft, #5b574e); margin: 0 0 8px; }
  .source-card { display: block; border: 1px solid var(--line, #e6e1d6); border-radius: 10px; padding: 10px 12px; margin-bottom: 8px; text-decoration: none; color: inherit; background: #fff; }
  .source-card:hover { border-color: var(--teal); background: var(--teal-soft); }
  .source-card .sc-name { font-size: .76rem; color: var(--teal-dark); font-weight: 700; }
  .source-card .sc-title { display: block; margin: 2px 0; }
  .source-card .sc-date { font-size: .74rem; color: var(--ink-soft, #5b574e); }

  .disclaimer-bar { position: sticky; bottom: 0; z-index: 5; background: var(--paper-2, #f5f5f5); border-top: 1px solid var(--line-strong, #d8d2c4); font-size: .82rem; color: var(--ink-soft, #5b574e); }
  .disclaimer-bar .container { padding-top: 10px; padding-bottom: 10px; }
  .disclaimer-bar b { color: var(--terra-dark); }

  @media (max-width: 640px) {
    .ask-row { flex-direction: column; }
  }
</style>

<script>
  // AI相談クライアント。/api/chat へ問い合わせ、出典付きの回答を表示する。
  // 通信失敗・サーバ側エラー時は丁寧なエラー表示にフォールバックする。
  type SourceRef = {
    source_name: string;
    title: string;
    url: string;
    updated_at?: string;
  };
  type ChatResponse = {
    answer: string;
    sources?: SourceRef[];
    fetched_at?: string;       // 情報取得日（免責③）
    disaster_scope?: string;   // 災害特設の但し書き用（免責③）
  };

  const form = document.getElementById('chat-form') as HTMLFormElement;
  const log = document.getElementById('chat-log') as HTMLElement;
  const questionInput = form.querySelector('#f-question') as HTMLTextAreaElement;
  const submitBtn = form.querySelector('.ask-go') as HTMLButtonElement;

  // 例質問チップ：タップで入力欄に転記（送信はユーザーの操作に委ねる）。
  document.querySelectorAll<HTMLButtonElement>('.ex-chip').forEach((chip) => {
    chip.addEventListener('click', () => {
      questionInput.value = chip.textContent?.trim() ?? '';
      questionInput.focus();
    });
  });

  function esc(s: string): string {
    return s.replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string)
    );
  }

  // AI回答の簡易 Markdown 整形。先に全体をエスケープしてから、
  // 見出し・太字・箇条書き・番号付きリスト・区切り線・インラインコード・https リンクだけをタグに戻す。
  // （外部ライブラリは使わない方針。表などそれ以外の記法はそのまま文字で表示する）
  function inline(s: string): string {
    return esc(s)
      .replace(/`([^`]+)`/g, '<code>$1</code>')
      .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
      .replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>');
  }

  type ListItem = { text: string; subs: string[] };

  function renderMarkdown(src: string): string {
    const out: string[] = [];
    let para: string[] = [];
    let list: { type: 'ul' | 'ol'; start: number; items: ListItem[] } | null = null;

    const flushPara = () => {
      if (para.length) out.push(`<p>${para.map(inline).join('<br />')}</p>`);
      para = [];
    };
    const flushList = () => {
      if (!list) return;
      const items = list.items
        .map((it) => {
          const subs = it.subs.length ? `<ul>${it.subs.map((t) => `<li>${inline(t)}</li>`).join('')}</ul>` : '';
          return `<li>${inline(it.text)}${subs}</li>`;
        })
        .join('');
      const start = list.type === 'ol' && list.start !== 1 ? ` start="${list.start}"` : '';
      out.push(`<${list.type}${start}>${items}</${list.type}>`);
      list = null;
    };

    for (const line of src.replace(/\r\n?/g, '\n').split('\n')) {
      if (!line.trim()) { flushPara(); flushList(); continue; }

      const h = line.match(/^\s*(#{1,6})\s+(.*?)\s*#*\s*$/);
      if (h) {
        flushPara(); flushList();
        const tag = h[1].length <= 2 ? 'h3' : 'h4';
        out.push(`<${tag}>${inline(h[2])}</${tag}>`);
        continue;
      }
      if (/^\s*([-*_])(\s*\1){2,}\s*$/.test(line)) { flushPara(); flushList(); out.push('<hr />'); continue; }

      const ul = line.match(/^(\s*)[-*+・]\s+(.*)$/);
      const ol = line.match(/^(\s*)(\d+)[.)．]\s+(.*)$/);
      const m = ul ?? ol;
      if (m) {
        flushPara();
        const indent = m[1].replace(/\t/g, '  ').length;
        const text = ul ? ul[2] : (ol as RegExpMatchArray)[3];
        // 字下げされた項目は、直前の項目の子リストにする
        if (indent >= 2 && list && list.items.length) {
          list.items[list.items.length - 1].subs.push(text);
          continue;
        }
        const type = ul ? 'ul' : 'ol';
        if (!list || list.type !== type) {
          flushList();
          list = { type, start: ol ? Number(ol[2]) : 1, items: [] };
        }
        list.items.push({ text, subs: [] });
        continue;
      }

      // 字下げされた続きの行は、直前の項目に連結する
      if (list && /^\s{2,}/.test(line) && list.items.length) {
        const last = list.items[list.items.length - 1];
        if (last.subs.length) last.subs[last.subs.length - 1] += ' ' + line.trim();
        else last.text += ' ' + line.trim();
        continue;
      }
      flushList();
      para.push(line.trim());
    }
    flushPara(); flushList();
    return `<div class="md">${out.join('')}</div>`;
  }

  function addUser(text: string) {
    const el = document.createElement('div');
    el.className = 'msg msg-user';
    el.innerHTML = `<div class="msg-body">${esc(text)}</div>`;
    log.appendChild(el);
  }

  function addAi(html: string, pending = false): HTMLElement {
    const el = document.createElement('div');
    el.className = 'msg msg-ai' + (pending ? ' msg-pending' : '');
    el.innerHTML = `<p class="msg-meta">ReadyBridge AI</p><div class="msg-body">${html}</div>`;
    log.appendChild(el);
    el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    return el;
  }

  function renderSources(sources: SourceRef[]): string {
    if (!sources.length) return '';
    const cards = sources
      .map(
        (s) => `<a class="source-card" href="${esc(s.url)}" target="_blank" rel="noopener">
          <span class="sc-name">${esc(s.source_name)}</span>
          <span class="sc-title">${esc(s.title)}</span>
          ${s.updated_at ? `<span class="sc-date">最終更新：${esc(s.updated_at)}</span>` : ''}
        </a>`
      )
      .join('');
    return `<div class="sources"><p class="sources-title">出典（必ず公式ページでご確認ください）</p>${cards}</div>`;
  }

  function renderAnswer(data: ChatResponse): string {
    let html = renderMarkdown(data.answer);
    if (data.disaster_scope) {
      html += `<p class="disaster-note">これは特定災害（${esc(data.disaster_scope)}）向けの制度を含みます。対象・期限を必ずご確認ください。</p>`;
    }
    html += renderSources(data.sources ?? []);
    if (data.fetched_at) {
      html += `<p class="msg-meta" style="margin:10px 0 0">情報取得日：${esc(data.fetched_at)}</p>`;
    }
    return html;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const question = String(fd.get('question') || '').trim();
    if (!question) return;

    addUser(question);
    questionInput.value = '';
    submitBtn.disabled = true; // 多重送信防止
    const pending = addAi('回答を考えています', true);

    try {
      const res = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ question }),
      });
      if (!res.ok) throw new Error(`status ${res.status}`);
      const data = (await res.json()) as ChatResponse;
      pending.classList.remove('msg-pending');
      (pending.querySelector('.msg-body') as HTMLElement).innerHTML = renderAnswer(data);
    } catch {
      // 通信失敗・サーバ側エラー時のフォールバック
      pending.classList.remove('msg-pending');
      (pending.querySelector('.msg-body') as HTMLElement).innerHTML =
        'うまく回答を取得できませんでした。少し時間をおいて、もう一度お試しください。' +
        'お急ぎの場合は <a href="/faq">記事一覧</a> もご活用ください。';
    } finally {
      submitBtn.disabled = false;
    }
  });
</script>
